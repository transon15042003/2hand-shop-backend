{
  "name": "hk-small-store-backend",
  "version": "1.0.0",
  "description": "Backend API Server for hk-small-store with Express, Drizzle ORM and PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "admin:create-owner": "tsx scripts/admin-create-owner.ts",
    "check:admin-rbac": "tsx scripts/check-admin-rbac.ts",
    "typecheck": "tsc --noEmit",
    "job:expire-holds": "tsx scripts/run-hold-expire.ts",
    "check:hold-expire": "tsx scripts/check-hold-expire-job.ts",
    "check:openapi-contract": "tsx scripts/check-openapi-contract.ts",
    "check:production-hardening": "tsx scripts/check-production-hardening.ts",
    "check:batch-costs-sale-item-mgmt": "tsx scripts/check-batch-costs-sale-item-mgmt.ts",
    "check:customer-email-flow": "tsx scripts/check-customer-email-flow.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
