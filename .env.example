# cp .env.example .env  — không commit .env
# Docs: docs/06-operations/setup.md

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Docker: docker compose up -d (giữ URL dưới)
# Neon: https://console.neon.tech → Project → Connect → copy URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/twohand_shop

# --- Secrets ---
# Tạo random: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=twohand_shop_jwt_secret_dev_key_2026
ADMIN_SESSION_TOKEN=twohand_admin_token_2026
ADMIN_PASSWORD=admin123

# --- Seed (local only) ---
SEED_CUSTOMER_PASSWORD=123456

# --- Hold expire (ADR 007) ---
# In-process poll interval (ms). Default 180000 (3 min). Set 0 to disable; use cron + `pnpm run job:expire-holds` instead.
HOLD_EXPIRE_INTERVAL_MS=180000

# --- Vercel Blob (POST /api/admin/uploads) ---
# https://vercel.com → Storage → Blob → Create/Open store → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- Rate limits (optional; defaults in rate-limit.middleware.ts) ---
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_ORDER_MAX=30
# RATE_LIMIT_ADMIN_MAX=10
