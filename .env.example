PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/twohand_shop"
JWT_SECRET="your_jwt_secret_key"
ADMIN_SESSION_TOKEN="your_admin_session_token"
# Optional — admin login password (default admin123). Token returned is ADMIN_SESSION_TOKEN.
# ADMIN_PASSWORD=admin123
CORS_ORIGIN="http://localhost:3000"
# Optional — password for seeded customer (default 123456)
# SEED_CUSTOMER_PASSWORD=123456
# Vercel Blob — required for POST /api/admin/uploads (local: create store in Vercel dashboard → token)
BLOB_READ_WRITE_TOKEN=
