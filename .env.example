# =============================================================================
# 2hand-shop-backend — mẫu môi trường local
# =============================================================================
# Cách dùng:
#   1) cp .env.example .env
#   2) Điền từng dòng theo hướng dẫn bên dưới (bỏ trống = sẽ fail khi dùng)
#   3) Không commit file .env
#
# Chi tiết thêm: docs/06-operations/setup.md
# =============================================================================

# --- Server -----------------------------------------------------------------
# PORT: cổng HTTP Express. PaaS (Render/…) sẽ ghi đè biến này.
PORT=5000

# NODE_ENV: development | production
NODE_ENV=development

# --- Database (Postgres) ----------------------------------------------------
# DATABASE_URL: connection string Postgres.
#
# Cách tạo / tìm:
#   A) Docker local (repo này):
#        docker compose up -d
#      → dùng đúng chuỗi mặc định bên dưới (khớp docker-compose.yml).
#   B) Postgres cài sẵn trên máy:
#      → postgresql://USER:PASSWORD@localhost:5432/DB_NAME
#   C) Neon (cloud):
#        https://console.neon.tech → Project → Connect → Connection string
#      → copy "URI" (ưu tiên pooled nếu PaaS serverless).
#
DATABASE_URL=postgresql://postgres:password@localhost:5432/twohand_shop

# --- Secrets (đổi khi không chỉ chơi local) ---------------------------------
# JWT_SECRET: ký JWT (auth util). Local có thể giữ mẫu; production phải random.
# Cách tạo:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=twohand_shop_jwt_secret_dev_key_2026

# ADMIN_SESSION_TOKEN: giá trị Bearer / cookie admin sau login thành công.
# Middleware so khớp token này. Local giữ mẫu; production phải random (cùng lệnh trên).
ADMIN_SESSION_TOKEN=twohand_admin_token_2026

# ADMIN_PASSWORD: mật khẩu đăng nhập /admin/login (FE).
# Mặc định code: admin123 nếu bỏ dòng này. Production: đặt mật khẩu mạnh.
ADMIN_PASSWORD=admin123

# --- CORS -------------------------------------------------------------------
# CORS_ORIGIN: origin Next.js (FE). Local = http://localhost:3000
# Production = URL Vercel FE, ví dụ https://2hand-shop.vercel.app
CORS_ORIGIN=http://localhost:3000

# --- Seed (chỉ local / staging; không chạy seed trên production) ------------
# SEED_CUSTOMER_PASSWORD: mật khẩu khách seed (email khachhang@2handshop.vn).
# Mặc định code: 123456 nếu bỏ dòng này.
SEED_CUSTOMER_PASSWORD=123456

# --- Vercel Blob (upload ảnh admin — POST /api/admin/uploads) ---------------
# BLOB_READ_WRITE_TOKEN: bắt buộc khi upload ảnh từ admin.
#
# Cách tạo / tìm:
#   1) https://vercel.com → đăng nhập
#   2) Storage → Create → Blob Store (hoặc mở store đã có)
#   3) Tab ".env.local" / Tokens → copy BLOB_READ_WRITE_TOKEN
#      (token dạng vercel_blob_rw_…)
#   4) Dán vào đây. Local và production dùng cùng loại token Read/Write.
#
# Thiếu token → upload trả 500 với message rõ (không crash process).
BLOB_READ_WRITE_TOKEN=
