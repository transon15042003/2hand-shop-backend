# cp .env.example .env  — không commit .env
# Docs: docs/06-operations/setup.md

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Docker: docker compose up -d (giữ URL dưới)
# Neon: https://console.neon.tech → Project → Connect → copy URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/hk_small_store

# --- Secrets ---
# Tạo random: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=hk_small_store_jwt_secret_dev_key_2026
# Legacy (không còn dùng cho login admin). Tạo owner: pnpm run admin:create-owner -- --username … --password …
# ADMIN_SESSION_TOKEN=
# ADMIN_PASSWORD=

# --- Seed (local only) ---
SEED_CUSTOMER_PASSWORD=123456

# --- Hold expire (ADR 007) ---
# In-process poll interval (ms). Default 180000 (3 min). Set 0 to disable; use cron + `pnpm run job:expire-holds` instead.
HOLD_EXPIRE_INTERVAL_MS=180000

# --- Vercel Blob (POST /api/admin/uploads) ---
# Store must be **Public** (ảnh món cần URL công khai trên kệ). Private store → upload 500.
# https://vercel.com → Storage → Blob → Create store (Access: Public) → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- Rate limits (optional; defaults in rate-limit.middleware.ts) ---
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_ORDER_MAX=30
# RATE_LIMIT_ADMIN_MAX=10

# --- Email Notifications ---
# Primary provider: Resend API (HTTP fetch over port 443 — Render Free compatible & preserves privacy)
# Testing sender: "HK Small Store <onboarding@resend.dev>" (only sends to Resend account owner email)
# Production sender: "HK Small Store <no-reply@yourdomain.com>" (requires verified domain at resend.com/domains)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="HK Small Store <onboarding@resend.dev>"

# Optional fallback: Gmail SMTP (Note: Render Free blocks ports 25, 465, 587; and From header will show your personal Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_gmail_app_password

